generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  farmer
  dealer
  machineOwner
  agency
  admin
}

enum AgencyVerificationStatus {
  pending
  approved
  rejected
  suspended
}

enum MachineType {
  tractor
  harvester
  sprayer
}

enum BookingStatus {
  pending
  approved
  rejected
  completed
}

enum Source {
  whatsapp
  web
}

enum Language {
  ta
  en
}

enum MessageDirection {
  inbound
  outbound
}

enum ProductCategory {
  seed
  fertilizer
  organic_fertilizer
  bio_fertilizer
  nutrient
  plant_protection
  tool
  irrigation
  sprayer
  other
}

enum OrderStatus {
  pending
  confirmed
  processing
  ready
  completed
  cancelled
  rejected
}

model users {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  email         String?
  password_hash String
  role          Role
  village       String?
  district      String?
  land_size     Float?
  language      Language @default(ta)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relationships
  agency_profile            agency_profiles?
  farmer_crops              farmer_crops[]
  machines                  machines[]
  machine_bookings_as_farmer machine_bookings[] @relation("FarmerBookings")
  machine_bookings_as_owner machine_bookings[]  @relation("OwnerBookings")
  whatsapp_sessions         whatsapp_sessions[]
  disease_detections        disease_detections[]
  products                  products[]
  cart                      carts?
  product_orders            product_orders[]

  @@index([phone])
  @@index([role])
  @@index([district])
}

model agency_profiles {
  id                   String                   @id @default(uuid())
  user_id              String                   @unique
  business_name        String
  business_description String?
  phone                String
  email                String?
  address              String
  village              String
  district             String
  pincode              String
  gst_number           String?
  license_number       String?
  logo_url             String?
  verification_status  AgencyVerificationStatus @default(pending)
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  user users @relation(fields: [user_id], references: [id])
}

model farmer_crops {
  id        String @id @default(uuid())
  user_id   String
  crop_name String

  user users @relation(fields: [user_id], references: [id])
}

model crop_prices {
  id          String   @id @default(uuid())
  crop_name   String
  market      String?
  district    String
  modal_price Float
  price_date  DateTime

  @@index([crop_name])
  @@index([district])
  @@index([market])
  @@index([price_date])
}

model machines {
  id             String      @id @default(uuid())
  owner_id       String
  machine_type   MachineType
  name           String
  description    String?
  price_per_day  Float
  district       String
  location       String?
  photo_url      String?
  is_available   Boolean     @default(true)

  owner            users                       @relation(fields: [owner_id], references: [id])
  unavailable_dates machine_unavailable_dates[]
  bookings         machine_bookings[]

  @@index([machine_type])
  @@index([district])
}

model machine_unavailable_dates {
  id         String   @id @default(uuid())
  machine_id String
  date       DateTime

  machine machines @relation(fields: [machine_id], references: [id])
}

model machine_bookings {
  id               String        @id @default(uuid())
  farmer_id        String
  farmer_phone     String
  machine_id       String
  machine_type     MachineType
  requested_date   DateTime
  status           BookingStatus @default(pending)
  machine_owner_id String
  admin_note       String?
  source           Source
  created_at       DateTime      @default(now())

  farmer        users    @relation("FarmerBookings", fields: [farmer_id], references: [id])
  machine       machines @relation(fields: [machine_id], references: [id])
  machine_owner users    @relation("OwnerBookings", fields: [machine_owner_id], references: [id])

  @@index([status])
  @@index([requested_date])
}

model whatsapp_sessions {
  id              String   @id @default(uuid())
  phone_number    String   @unique
  user_id         String?
  language        Language @default(ta)
  current_flow    String
  context         Json     @default("{}")
  last_message_at DateTime @default(now())

  user users? @relation(fields: [user_id], references: [id])

  @@index([phone_number])
}

model whatsapp_message_logs {
  id            String           @id @default(uuid())
  phone_number  String
  direction     MessageDirection
  message_type  String
  content       String?
  media_id      String?
  wa_message_id String?
  status        String
  created_at    DateTime         @default(now())

  @@index([phone_number])
}

model disease_detections {
  id                String   @id @default(uuid())
  farmer_id         String?
  phone_number      String
  disease           String
  confidence        Float
  crop              String
  recommendation_en String?
  recommendation_ta String?
  created_at        DateTime @default(now())

  farmer users? @relation(fields: [farmer_id], references: [id])

  @@index([phone_number])
  @@index([created_at])
}

model products {
  id             String          @id @default(uuid())
  agency_id      String
  name           String
  description    String?
  category       ProductCategory
  crop_name      String?
  brand          String?
  unit           String
  price          Float
  stock_quantity Int
  image_url      String?
  district       String
  is_available   Boolean         @default(true)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  agency      users                 @relation(fields: [agency_id], references: [id])
  cart_items  cart_items[]
  order_items product_order_items[]

  @@index([agency_id])
  @@index([category])
  @@index([crop_name])
  @@index([district])
  @@index([is_available])
}

model carts {
  id        String @id @default(uuid())
  farmer_id String @unique

  farmer     users        @relation(fields: [farmer_id], references: [id])
  cart_items cart_items[]
}

model cart_items {
  id         String @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int

  cart    carts    @relation(fields: [cart_id], references: [id])
  product products @relation(fields: [product_id], references: [id])
}

model product_orders {
  id               String      @id @default(uuid())
  farmer_id        String
  total_amount     Float
  status           OrderStatus @default(pending)
  delivery_address String
  phone            String
  source           Source
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  farmer      users                 @relation(fields: [farmer_id], references: [id])
  order_items product_order_items[]

  @@index([farmer_id])
  @@index([status])
  @@index([created_at])
}

model product_order_items {
  id         String @id @default(uuid())
  order_id   String
  product_id String
  agency_id  String
  quantity   Int
  unit_price Float
  subtotal   Float

  order   product_orders @relation(fields: [order_id], references: [id])
  product products       @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([agency_id])
}
